{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core", "ultracite/biome/react"],
  "files": {
    // Each model app is the artifact under test — kept exactly as the model
    // wrote it, so it is neither linted nor formatted to this repo's standards.
    "includes": [
      "!apps/opus-5",
      "!apps/kimi-k3",
      "!apps/grok-4.5",
      "!apps/fable-5",
      "!apps/fable-5.1",
      "!apps/sol-ultra",
      "!apps/terra-ultra",
      "!apps/luna-extra-high",
      "!apps/gpt-5.5",
      "!apps/sonnet-5",
      "!apps/glm-5.2",
      "!apps/gemini-3.7-flash",
      "!apps/gemini-3.8-flash",
      "!apps/grok-4.6",
      "!apps/playground/public/models"
    ]
  }
}
